{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TranslatorPet",
  "version": "1.0.0",
  "identifier": "com.tauri-app.translator",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "翻译",
        "width": 380,
        "height": 460,
        "decorations": false,
        "alwaysOnTop": true,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "resizable": true,
        "minWidth": 360,
        "minHeight": 380
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "TranslatorPet",
    "shortDescription": "划词翻译 + 生词本 + 桌面宠物",
    "longDescription": "划词翻译、生词本复习和桌面宠物。",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}